{
    "name": "lad_stack_overflow",
    "version": "1.0.0",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.esm.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "README.md",
        "package.json"
    ],
    "peerDependencies": {
        "react": ">=17",
        "react-dom": ">=17"
    },
    "scripts": {
        "start": "webpack serve --config webpack.config.mjs --mode development",
        "prepublishOnly": "npm run build",
        "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
        "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "test": "jest",
        "test:watch": "jest --watch",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "pack": "npm pack"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nadja-git-a/Custom-components-lib.git"
    },
    "bugs": {
        "url": "https://github.com/nadja-git-a/Custom-components-lib/issues"
    },
