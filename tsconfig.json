{
    "compilerOptions": {
      "declaration": true,
      "emitDeclarationOnly": true,
      "declarationMap": false,
      "outDir": "dist/types",
      "rootDir": "src",
      "skipLibCheck": true,
      "module": "ESNext",
      "target": "ES2019",
      "moduleResolution": "Node",
      "jsx": "react-jsx",
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src"],
    "exclude": [
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.stories.ts",
      "**/*.stories.tsx",
      "stories/**"
    ]
  }
  